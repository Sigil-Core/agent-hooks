{
  "name": "@sigilcore/agent-hooks",
  "version": "0.8.1",
  "description": "PreToolUse interceptor for autonomous AI agents - policy enforcement via Sigil Sign",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sigil-Core/agent-hooks.git"
  },
  "publishConfig": {
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:cjs-runtime": "node scripts/verify-cjs-warrant-runtime.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "publish:guard": "node scripts/publish-guard.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@sigilcore/warrant-core": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "yaml": "2.9.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
